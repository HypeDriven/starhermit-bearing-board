{
  "styles": {
    ".btn": {
      "background": "$panel-solid",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 8.8,
        "end": 15.2,
        "bottom": 8.8,
        "start": 15.2
      },
      "minWidth": 44,
      "minHeight": 44,
      "transition": {
        "properties": "background",
        "duration": 0.12,
        "easing": "ease"
      },
      "text": {
        "color": "$ink",
        "align": "center"
      },
      "hovered": {
        "background": "#1d2140"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.42
      }
    },
    ".btn-primary": {
      "background": "$accent",
      "border": {
        "color": "$accent"
      },
      "text": {
        "color": "$accent-ink",
        "weight": "700"
      },
      "hovered": {
        "background": "#e6c477"
      }
    },
    ".btn-danger": {
      "border": {
        "color": "$danger"
      },
      "text": {
        "color": "#f0b0a5"
      }
    },
    ".btn-icon": {
      "padding": {
        "top": 4.8,
        "end": 11.2,
        "bottom": 4.8,
        "start": 11.2
      },
      "text": {
        "weight": "700",
        "letterSpacing": "0.1em"
      }
    },
    ".btn-menu": {
      "text": {
        "size": 16.8
      }
    },
    ".btn-compact": {
      "padding": {
        "top": 5.6,
        "end": 9.6,
        "bottom": 5.6,
        "start": 9.6
      }
    },
    ".hud-chip": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 6.4,
        "end": 12.8,
        "bottom": 6.4,
        "start": 12.8
      }
    },
    ".objective": {
      "text": {
        "size": 15.2
      }
    },
    ".objective-small": {
      "text": {
        "size": 13.6
      }
    },
    ".turn": {
      "text": {
        "weight": "600"
      }
    },
    ".dice-tray": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 3.2,
        "end": 6.4,
        "bottom": 3.2,
        "start": 6.4
      },
      "minHeight": 44
    },
    ".dice-none": {
      "text": {
        "color": "$ink-dim",
        "size": 13.6
      }
    },
    ".die": {
      "background": "#f2ead6",
      "radius": 8,
      "shadow": {
        "y": -3,
        "color": "#00000040",
        "inset": true
      },
      "width": 36,
      "height": 36,
      "text": {
        "color": "#2a1c10",
        "size": 21.6,
        "weight": "800",
        "align": "center"
      }
    },
    ".die-small": {
      "width": 30,
      "height": 30,
      "text": {
        "size": 16.8
      }
    },
    ".die-used": {
      "opacity": 0.35
    },
    ".die-doubles": {
      "border": {
        "width": 3,
        "color": "$accent",
        "style": "solid"
      }
    },
    ".rail": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "padding": 12
    },
    ".rail-title": {
      "margin": {
        "top": 5.6,
        "end": 0,
        "bottom": 4,
        "start": 0
      },
      "text": {
        "color": "$ink-dim",
        "size": 11.52,
        "letterSpacing": "0.14em",
        "transform": "uppercase"
      }
    },
    ".rail-text": {
      "margin": {
        "top": 4,
        "end": 0,
        "bottom": 4,
        "start": 0
      },
      "text": {
        "size": 14.72
      }
    },
    ".pip": {
      "text": {
        "size": 14.72
      }
    },
    ".player-row": {
      "radius": 6,
      "padding": {
        "top": 4.8,
        "end": 4,
        "bottom": 4.8,
        "start": 4
      }
    },
    ".player-row-active": {
      "background": "#d8b25c29"
    },
    ".badge": {
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 999,
      "padding": {
        "top": 1.968,
        "end": 9.184,
        "bottom": 1.968,
        "start": 9.184
      },
      "text": {
        "color": "$ink-dim",
        "size": 13.12
      }
    },
    ".badge-on": {
      "border": {
        "color": "$accent"
      },
      "text": {
        "color": "$accent"
      }
    },
    ".tray": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "padding": 8
    },
    ".tutorial": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$accent",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 9.6,
        "end": 14.4,
        "bottom": 9.6,
        "start": 14.4
      }
    },
    ".veil": {
      "background": "#05060e99"
    },
    ".card": {
      "background": "$panel-solid",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 14,
      "shadow": {
        "y": 18,
        "blur": 60,
        "color": "#0000008c"
      },
      "padding": {
        "top": 20,
        "end": 24,
        "bottom": 20,
        "start": 24
      }
    },
    ".card-title": {
      "margin": {
        "top": 0,
        "end": 0,
        "bottom": 6.4,
        "start": 0
      },
      "text": {
        "size": 24,
        "weight": "700"
      }
    },
    ".toast": {
      "background": "$panel-solid",
      "border": {
        "width": 1,
        "color": "$accent",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 8,
        "end": 16,
        "bottom": 8,
        "start": 16
      },
      "text": {
        "align": "center"
      }
    },
    ".screen": {
