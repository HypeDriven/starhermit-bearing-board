          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      }
    },
    ".tile-name": {
      "text": {
        "weight": "700"
      }
    },
    ".tile-sub": {
      "text": {
        "color": "$ink-dim",
        "size": 13.6
      }
    },
    ".stars": {
      "text": {
        "color": "$accent",
        "letterSpacing": "0.15em"
      }
    },
    ".stars-big": {
      "text": {
        "color": "$accent",
        "size": 25.6,
        "letterSpacing": "0.15em",
        "align": "center"
      }
    },
    ".chapter": {
      "margin": {
        "top": 6.4,
        "end": 0,
        "bottom": 0,
        "start": 0
      },
      "text": {
        "color": "$ink-dim",
        "size": 13.6,
        "letterSpacing": "0.14em",
        "transform": "uppercase"
      }
    },
    ".field-label": {
      "text": {
        "color": "$ink-dim",
        "size": 13.6
      }
    },
    ".kbd": {
      "background": "$field",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
