        "shadow": {
          "y": 2,
          "blur": 24,
          "color": "#d8b25c40"
        }
      }
    },
    ".page-title": {
      "text": {
        "size": 32,
        "weight": "700"
      }
    },
    ".headline": {
      "text": {
        "size": 35.2,
        "weight": "700",
        "align": "center"
      }
    },
    ".tagline": {
      "margin": {
        "top": 4,
        "end": 0,
        "bottom": 0,
        "start": 0
      },
      "text": {
        "color": "$ink-dim"
      }
    },
    ".tagline-center": {
      "text": {
        "color": "$ink-dim",
        "align": "center"
      }
    },
