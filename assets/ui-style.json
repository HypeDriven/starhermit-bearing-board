        "y": 18,
        "blur": 50,
        "color": "#0000008c"
      }
    },
    ".section": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 14,
      "padding": {
        "top": 16,
        "end": 18.4,
        "bottom": 16,
        "start": 18.4
      }
    },
    ".section-title": {
      "margin": {
        "top": 0,
        "end": 0,
        "bottom": 8,
        "start": 0
      },
      "text": {
        "size": 18.4,
        "weight": "700"
      }
    },
    ".sub-title": {
      "margin": {
        "top": 12,
        "end": 0,
        "bottom": 5.6,
        "start": 0
      },
      "text": {
        "size": 16,
        "weight": "700"
      }
    },
    ".body-text": {
      "margin": {
        "top": 4,
        "end": 0,
        "bottom": 4,
        "start": 0
      }
    },
    ".tile": {
      "background": "$panel-solid",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 11.2,
        "end": 12.8,
        "bottom": 11.2,
        "start": 12.8
