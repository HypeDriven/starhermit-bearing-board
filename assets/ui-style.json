    ".cell": {
      "padding": {
        "top": 5.6,
        "end": 8,
        "bottom": 5.6,
        "start": 8
      }
    },
    ".danger-text": {
      "text": {
        "color": "$danger"
      }
    }
  },
  "animations": {},
  "tokens": {
    "accent": "#d8b25c",
    "accent-ink": "#241a08",
    "bg": "#0e1020",
    "danger": "#d06a5a",
    "field": "#0d1024",
    "focus": "#ffd97a",
    "ink": "#f0ead8",
    "ink-dim": "#b8b09a",
    "line": "#d8b25c59",
    "panel": "#101222eb",
    "panel-solid": "#151830"
  },
  "layouts": {},
  "dropped": []
}
